# systemd unit for the Shop Dashboard gunicorn server.
# Installed by deploy/setup_ubuntu.sh to /etc/systemd/system/shopboard.service
[Unit]
Description=Shop Dashboard (gunicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=shopboard
Group=www-data
WorkingDirectory=/srv/shopboard/app/shopboard
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
RuntimeDirectory=shopboard
ExecStart=/srv/shopboard/venv/bin/gunicorn config.wsgi:application \
    --workers 3 \
    --bind unix:/run/shopboard/gunicorn.sock \
    --timeout 120 \
    --access-logfile - \
    --error-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
