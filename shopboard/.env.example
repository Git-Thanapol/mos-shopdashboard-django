# Copy to .env and fill in. .env is gitignored.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=1
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=shopboard
POSTGRES_USER=shopboard
POSTGRES_PASSWORD=shopboard
# host "db" inside compose; use localhost:5433 from the host machine
DATABASE_URL=postgres://shopboard:shopboard@db:5432/shopboard

# Initial admin account (created by `manage.py ensure_superuser` on startup)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# SMTP for OTP mail (prod). Dev uses the console backend automatically.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Shop Dashboard <noreply@example.com>

# Optional Google Sheet master import; app works fully without these
GOOGLE_APPLICATION_CREDENTIALS=
SHEET_MASTER_URL=
